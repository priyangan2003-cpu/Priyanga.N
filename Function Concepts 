        "    result=func(*args,**kwargs)\n",
        "    end=time.time()\n",
        "    print(f\"{func._name_}ran in {end-start:.4f}s\")\n",
        "    return result\n",
        "  return wrapper\n",
        "@timer_decorator\n",
        "def compute_sun(n):\n",
